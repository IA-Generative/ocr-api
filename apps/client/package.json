{
  "name": "frontend",
  "type": "module",
  "version": "0.19.11",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.6",
      "@babel/core": ">=7.29.6",
      "serialize-javascript": ">=7.0.5"
    }
  },
  "scripts": {
    "build": "run-s build-only type-check",
    "build-only": "vite build",
    "clean": "rimraf dist node_modules/.tmp node_modules/.vite",
    "dev": "vite",
    "format": "eslint . --fix",
    "generate-openapi": "openapi-typescript ${VITE_OCR_API_URL}/openapi.json -o ./src/api/types/api.schema.d.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "run-s test:unit test:e2e",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@gouvfr/dsfr": "~1.14.4",
    "@gouvminint/vue-dsfr": "^8.17.0",
    "@sentry/vue": "^10.62.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vueuse/components": "^13.9.0",
    "axios": "^1.18.1",
    "focus-trap": "^7.8.0",
    "focus-trap-vue": "^4.1.0",
    "keycloak-js": "^26.2.4",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39",
    "vue-matomo": "^4.2.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@playwright/test": "^1.61.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-playwright": "^2.10.4",
    "jsdom": "^27.4.0",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^3.2.6",
    "vue-tsc": "^3.3.5",
    "workbox-window": "^7.4.1"
  }
}
