{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": false,
      "include-component-in-tag": false,
      "bootstrap-sha": "751f3dca521a389f79ce9e77f41355aa0a4b4462",
      "extra-files": [
        {
          "type": "toml",
          "path": "apps/server/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "apps/server/uv.lock",
          "jsonpath": "$.package[?(@.name=='ocr-api')].version"
        }, 
        {
          "type": "json",
          "path": "apps/client/package.json",
          "jsonpath": "$.version"
        }, 
        {
          "type": "toml",
          "path": "sdk/pyproject.toml",
          "jsonpath": "project.version"
        }, 
        {
          "type": "toml",
          "path": "sdk/uv.lock",
          "jsonpath": "$.package[?(@.name=='ocr-sdk')].version"
        }
      ]
    }
  }
}
