# FRONTEND CONFIGURATION (Vue)
NODE_ENV=development
FRONT_PORT=5173
VITE_OCR_API_URL=http://localhost:5000/api
VITE_PORTAIL_URL=https://portail.example.gov
VITE_USER_REVIEW_URL=https://reviews.example.gov
VITE_TCHAP_CANAL_URL=https://tchap.example/groupe/abc
# MATOMO
VITE_MATOMO_SITE_URL=https://matomo.example.gov
VITE_MATOMO_SITE_ID=42
# KEYCLOAK
VITE_KEYCLOAK_URL=http://localhost:8080/auth
VITE_KEYCLOAK_CLIENT_ID=ocr-frontend
VITE_KEYCLOAK_REALM=master
VITE_REDIRECT_URI=http://localhost:8081
VITE_USERNAME_KEYCLOAK=e2e_user
VITE_PASSWORD_KEYCLOAK=ChangeMe123!

# Optional (frontend / backend)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4o-mini

# --- Server / Docker variables (used by docker-compose) ---
# Database
DATABASE_URL=postgresql://postgres:secret@db:5432/example_db
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:secret@db:5432/example_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# S3 / MinIO
S3_BUCKET_NAME=test
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000
VERIFY_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Paddle / OCR
PADDLE_OCR_BASE_DIR=/app/models/paddle/
PADDLE_PDX_CACHE_HOME=/app/models/paddlex/
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# Service configuration
ENVIRONMENT=development
SERVICE_NAME=ocr_api
CELERY_APP_NAME=default
WORKER_NAME=worker.tasks.ocr
PROCESS_NAME=paddleocr-2.10.0


VERIFY_TOKEN_MODEL=full-access