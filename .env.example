# KEYCLOAK (BFF: the browser never talks to Keycloak, only the backend does - see
# ocr_backend/routers/auth.py. These point at the local `keycloak` compose service,
# pre-provisioned by docker/keycloak/realm-mirai.json.)
# KEYCLOAK_URL is reached backend-to-container (token exchange, introspect, refresh);
# KEYCLOAK_PUBLIC_URL is where the browser gets redirected to log in.
KEYCLOAK_URL=
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
BACKEND_PUBLIC_URL=
FRONTEND_URL=
# Local dev is plain HTTP: a `Secure` cookie would never be sent back by the browser.
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=
VERIFY_TOKEN_MODEL=
# Machine-to-machine auth (SDK, scripts): bypasses the Keycloak session cookie entirely
# via `Authorization: Bearer <key>` - unrelated to VERIFY_TOKEN_MODEL, checked first.
# `default-api-key` matches sdk/tests/ocr_sdk/test_client_sync.py.
API_KEYS=


TORCH_HOME=
HF_HOME=
MODEL_FEATURE_NAME=
# Tests E2E
VITE_USERNAME_KEYCLOAK=
VITE_PASSWORD_KEYCLOAK=

# LOGGING PYTHON
SERVICE_NAME=
ENVIRONMENT=

# PURGE (periodic deletion of old tasks + their S3 files via Celery Beat, see the `beat` service)
PURGE_ENABLED=
TASK_RETENTION_DAYS=
PURGE_BATCH_SIZE=
# Crontab schedule (celery.schedules.crontab): every day at 02:00 by default.
PURGE_CRON_MINUTE=
PURGE_CRON_HOUR=
PURGE_CRON_DAY_OF_WEEK=
PURGE_CRON_DAY_OF_MONTH=
PURGE_CRON_MONTH_OF_YEAR=
