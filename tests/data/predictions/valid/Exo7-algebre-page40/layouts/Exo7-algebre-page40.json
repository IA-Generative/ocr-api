    "content": "\\begin{array}{r l r}{z=z^{\\prime}}&{{}\\Longleftrightarrow}&{\\left\\{\\begin{array}{l l}{\\mathrm{R e}(z)=\\mathrm{R e}(z^{\\prime}),}\\\\ {\\quad\\mathrm{e t}}\\\\ {\\mathrm{I m}(z)=\\mathrm{I m}(z^{\\prime}).}\\end{array}\\right.}\\end{array}"
