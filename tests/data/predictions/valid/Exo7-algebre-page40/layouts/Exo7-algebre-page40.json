      800.3289184570312,
      2155.52880859375,
      1711.41455078125,
      2280.859130859375
    ],
    "content": "\\left\\{\\begin{array}{l l}{a^{\\prime}\\left(a^{2}+b^{2}\\right)=a}\\\\ {b^{\\prime}\\left(a^{2}+b^{2}\\right)=-b}\\end{array}\\right.\\quad\\mathrm{d o n c}\\quad\\left\\{\\begin{array}{l l}{a^{\\prime}=\\frac{a}{a^{2}+b^{2}}}\\\\ {b^{\\prime}=-\\frac{b}{a^{2}+b^{2}}}\\end{array}\\right."
  },
